# AI Webpage PDF Assistant — Environment Variables
# Chrome extensions cannot read .env files at runtime (no Node.js).
# This file is for documentation and local reference only.

# Mistral API Key (Recommended - Free tier: 2M tokens/month)
# Get a key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_key_here

# Gemini API Key (Alternative - Free tier: 15 req/min, 500 req/day)
# Get a key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_key_here

# Groq API Key (Alternative - Unlimited free, very fast)
# Get a key at: https://console.groq.com/
# GROQ_API_KEY=your_groq_key_here